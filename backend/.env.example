# ============================================
# ShopSmart Backend — Environment Variables
# ============================================
# Copy to .env and fill in real values.
# Leave DB_* empty to use SQLite (local dev).

# Django
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Database (PostgreSQL) — leave empty for SQLite fallback
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# CORS (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# AI Providers (optional — app works without them via rule-based fallback)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Logging
LOG_LEVEL=INFO
